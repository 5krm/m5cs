# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — THIS APP NEEDS NONE TO RUN.
#
# The 3D experience (/, the only page) has no backend, no database and no API
# keys. The variables below only matter for the optional, currently unused
# Prisma/SQLite scaffold (prisma/schema.prisma + src/lib/db.ts).
#
# Copy to `.env` only if you intend to use that scaffold:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# SQLite connection string for Prisma (see prisma/schema.prisma → datasource db).
# Use an absolute path on your own machine, e.g.:
#   DATABASE_URL="file:./db/custom.db"
DATABASE_URL="file:./db/custom.db"
